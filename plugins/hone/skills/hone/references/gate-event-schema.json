{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GateEvent",
  "description": "Structured gate event emitted at each phase transition in a multi-step skill or command. Written to the workflow state file under the gates[] array. Enables deterministic compliance checking by score_gate_compliance in score_execution.py.",
  "type": "object",
  "required": ["step", "judge", "result"],
  "properties": {
    "step": {
      "type": "string",
      "description": "Phase transition name, e.g. 'phase1_to_phase2', 'stage1_exit', 'pre_publish_gate'"
    },
    "judge": {
      "type": "string",
      "enum": ["automated", "self-check", "fresh-subagent", "model-judge", "opus-judge", "crucible-judge", "human"],
      "description": "Who evaluated this gate. Matches judge types in ~/.claude/protocols/gate-protocol.md. Prefer 'model-judge' (session-model judge) for new events; 'opus-judge' is retained for back-compat with older state files."
    },
    "result": {
      "type": "string",
      "enum": ["pass", "fail"],
      "description": "Gate outcome. 'fail' should only appear when the pipeline explicitly halted."
    },
    "rubric": {
      "type": "array",
      "description": "Optional: checklist items evaluated at this gate",
      "items": {
        "type": "object",
        "required": ["severity", "item", "result"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
          },
          "item": {
            "type": "string",
            "description": "The specific check performed, e.g. '0 CRITICAL findings'"
          },
          "result": {
            "type": "string",
            "enum": ["pass", "fail", "warn"]
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Optional: issues found at this gate"
    },
    "ts": {
      "type": "string",
      "description": "ISO 8601 timestamp of gate evaluation"
    }
  },
  "examples": [
    {
      "step": "phase1_to_phase2",
      "judge": "self-check",
      "result": "pass",
      "rubric": [
        {"severity": "CRITICAL", "item": "at_least_one_test_below_0.8", "result": "pass"},
        {"severity": "HIGH", "item": "eval_results_written_to_state", "result": "pass"}
      ],
      "ts": "2026-04-09T12:00:00-07:00"
    },
    {
      "step": "phase2_to_phase3",
      "judge": "self-check",
      "result": "pass",
      "ts": "2026-04-09T12:30:00-07:00"
    },
    {
      "step": "phase3_exit",
      "judge": "self-check",
      "result": "pass",
      "rubric": [
        {"severity": "CRITICAL", "item": "no_regression_greater_than_0.1", "result": "pass"},
        {"severity": "HIGH", "item": "round_scores_written_to_state", "result": "pass"}
      ],
      "ts": "2026-04-09T13:00:00-07:00"
    }
  ]
}
